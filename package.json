{
  "name": "ladakh-heritage-showcase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "validate:catalogue": "node scripts/validate-catalogue.mjs",
    "check": "npm test && npm run build",
    "format": "prettier --write src scripts tests README.md docs/HANDOFF.md index.html vite.config.js package.json .prettierrc.json",
    "format:check": "prettier --check src scripts tests README.md docs/HANDOFF.md index.html vite.config.js package.json .prettierrc.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.10.1",
    "vite": "^6.0.5"
  }
}
